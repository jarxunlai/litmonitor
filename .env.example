DATABASE_URL=sqlite:///./data/litmonitor.db

NCBI_API_KEY=

APP_HOST=127.0.0.1
APP_PORT=8000
DEFAULT_TIMEZONE=America/Chicago
SCHEDULER_ENABLED=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

LLM_ENABLED=false

# backend choices:
# none | openai-compatible | cli
LLM_BACKEND=openai-compatible

# OpenAI-compatible backend
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=0
LLM_THINKING_TYPE=
LLM_REASONING_EFFORT=
LLM_STREAM=false
LLM_TIMEOUT_SECONDS=60
LLM_FORCE_JSON_MODE=true
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=10
LLM_FALLBACK_BACKEND=

# CLI backend
LLM_CLI_COMMAND=codex
LLM_CLI_ARGS=exec --json
LLM_CLI_TIMEOUT_SECONDS=120

# LLM cost and safety controls
LLM_MAX_PAPERS_PER_RUN=20
LLM_MIN_RELEVANCE_SCORE=5
LLM_CACHE_ENABLED=true
DIGEST_MAX_PAPERS_PER_RUN=20
